#include<iostream>
using namespace std;
int main(){
    float a, b;
    char op;

    cout << "Entre two operation: ";
    cin >> a >> b;

    cout << "Entre operation (+, -, *, /, %): ";
    cin >>op;

    switch (op) {
        case '+':
             cout << "result = " << a + b;
             break;

        case '-':
            cout << "Result = " << a - b;
            break;

        case '*':
            cout << "Result = " << a * b;
            break;

        case '/':
            if (b == 0)
            cout << "Error: division by zero!";
            else
            cout << "Result = " << a / b;
            break;

        case '%':
             if (b == 0)
             cout << "Error: division by zero!";
             else
             cout << "Result = " << (int)a % (int)b;
             break;

        default:
            cout << "Invalid operater!"; 


    }


    return 0;
}
