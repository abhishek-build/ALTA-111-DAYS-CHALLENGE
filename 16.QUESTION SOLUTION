#include<iostream>
using namespace std;
int main(){
    int n, original, ans = 0, rem;

    cout << "Entre a number: ";
    cin >> n; 

    original = n;

    while ( n > 0){
        rem = n % 10;
        ans = ans * 10 + rem;
        n = n/10;

    }

if (original == ans)
    cout << "Palindrome";
    else
    cout << "not palindrome";

    
    return 0;
}
