#include <iostream>
#include <utility>
using namespace std;
pair<int, int> sumAndProduct(int a, int b) {
    return {a + b, a * b};
}

int main() {
    int a, b;
    cin >> a >> b;
    pair<int, int> ans = sumAndProduct(a, b);
    cout << ans.first << endl;
    cout << ans.second << endl;
    return 0;
}
