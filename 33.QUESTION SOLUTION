#include<iostream>
using namespace std;
int main(){
    int n;
    cout<<"Enter array size:";
    cin>>n;

    int arr[100];
    cout<<"Enter array elements:";
    for(int i = 0; i < n; i++){
        cin>>arr[i];
    }

    bool isSorted = true;
    for(int i = 0; i < n - 1; i++){
        if(arr[i] > arr[i + 1]){
            isSorted = false;
            break;
        }
    }

    if (isSorted == true){
        cout<<"Array is Sorted";
    }
    else{
        cout<<"Array is Not Sorted";
    }
}
