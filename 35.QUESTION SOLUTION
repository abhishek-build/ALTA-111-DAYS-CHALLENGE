#include<iostream>
using namespace std;
int main(){
    int n, d;
    int arr[100];
    cout<<"Enter array size:";
    cin>>n;

    cout<<"Enter array elements:";
    for(int i = 0; i < n; i++){
        cin>>arr[i];
    }
    cout<<"Enter rotation places:";
    cin>>d;
    d = d % n;

    for(int i = 0; i < d; i++){
        int first = arr[0];
        for(int j = 0; j < n - 1; j++){
            arr[j] = arr[j + 1];
        }
        arr[n - 1] = first;
    }
    cout<<"Rotated array:";

    for(int i = 0; i < n; i++){
        cout<<arr[i]<< " ";
    }
}


