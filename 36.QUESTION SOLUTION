#include<iostream>
using namespace std;
int main(){
    int n, arr[100];
    cout<<"Enter array size:";
    cin >> n;

    cout<<"Enter 0 and 1 elements:";
    for(int i = 0; i < n; i++){
        cin>>arr[i];
    }
    int count = 0;
    int maxCount = 0;
    for(int i = 0; i < n; i++){
        if(arr[i] == 1){
            count++;
            if(count > maxCount){
                maxCount = count;
            }
        }
        else{
            count = 0;
        }
    }
    cout << "Maximum consecutive ones: " << maxCount;
}
