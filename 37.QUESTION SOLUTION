#include<iostream>
using namespace std;
int main(){
    int n, arr[100], target;
    cout<<"Enter array size:";
    cin>>n;

    cout<<"Enter array elements:";
    for(int i = 0; i < n; i++){
        cin>>arr[i];
    }
    cout<<"Enter target:";
    cin>>target;
    for(int i = 0; i < n; i++){
        for(int j = i + 1; j < n; j++){
            if(arr[i] + arr[j] == target){
                cout<<"Answer:"<<i<<" "<<j;
                return 0;
            }
        }
    }
    cout<<"No solution found.";
}
