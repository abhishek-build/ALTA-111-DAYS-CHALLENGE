#include<iostream>
using namespace std;
int main(){
    int n, m;
    int a[100], b[100];
    cout<<"Enter size of first array:";
    cin>>n;

    cout<<"Enter first array elements:";
    for(int i = 0; i < n; i++){
        cin>>a[i];
    }
    cout<<"Enter size of second array:";
    cin>>m;

    cout<< "Enter second array elements:";
    for(int i = 0; i < m; i++){
        cin>>b[i];
    }

    cout<<"Union of arrays:";
    int i = 0, j = 0;
    while(i < n && j < m){
        if(a[i] < b[j]){
            cout<<a[i]<< " ";
            i++;
        }
        else if(a[i] > b[j]){
            cout<<b[j]<<" ";
            j++;
        }
        else{
            cout<<a[i]<<" ";
            i++;
            j++;
        }
    }
    while(i < n){
        cout<<a[i]<<" ";
        i++;
    }
    while(j < m){
        cout<<b[j]<<" ";
        j++;
    }
}
