#include<iostream>
using namespace std;
int main(){
    int n, arr[100];
    cout<<"Enter array size:";
    cin>>n;

    cout<<"Enter sorted array elements:";
    for(int i = 0; i < n; i++){
        cin>>arr[i];
    }
    for(int i = 0; i < n; i++){
        arr[i] = arr[i] * arr[i];
    }
    for(int i = 0; i < n; i++){
        for(int j = i + 1; j < n; j++){
            if(arr[i] > arr[j]){
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
    cout<<"Squares of sorted array:";
    for(int i = 0; i < n; i++){
        cout<<arr[i]<<" ";
    }
}
